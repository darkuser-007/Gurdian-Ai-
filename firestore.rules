rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny every collection unless it is explicitly opened below.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDetectionResult(data) {
      return data.keys().hasAll([
          'timestamp', 'phoneNumber', 'riskScore', 'verdict', 'signals', 'ownerId'
        ])
        && data.keys().hasOnly([
          'timestamp', 'phoneNumber', 'riskScore', 'verdict', 'signals',
          'ownerId', 'duration', 'isBlocked', 'isVerified', 'error'
        ])
        && data.timestamp is timestamp
        && data.phoneNumber is string
        && data.phoneNumber.size() <= 64
        && data.riskScore is number
        && data.riskScore >= 0
        && data.riskScore <= 100
        && data.verdict in ['authentic', 'suspicious', 'deepfake', 'error']
        && data.signals is list
        && data.signals.size() <= 50
        && data.ownerId == request.auth.uid
        && (data.get('duration', '--') is string)
        && (data.get('duration', '--').size() <= 32)
        && (data.get('isBlocked', false) is bool)
        && (data.get('isVerified', false) is bool)
        && (!('error' in data) || (data.error is string && data.error.size() <= 500));
    }

    match /history/{historyId} {
      allow create: if isSignedIn()
        && isValidId(historyId)
        && isValidDetectionResult(request.resource.data);

      // Queries must constrain ownerId to the authenticated user's UID.
      allow read: if isSignedIn() && isOwner(resource.data.ownerId);

      allow update: if isSignedIn()
        && isOwner(resource.data.ownerId)
        && isValidDetectionResult(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }
  }
}
