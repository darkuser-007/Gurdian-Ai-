# Server-only Gemini credentials. Never prefix this with VITE_.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# Optional: override the public Firebase Web API key from firebase-applet-config.json.
# The key identifies your Firebase project; Firebase ID tokens are still required.
FIREBASE_WEB_API_KEY=""

# Optional HTTP server port for local/self-hosted deployments.
PORT="3000"
